FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        ffmpeg \
        git \
        libsndfile1 \
        sox \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY src ./src
COPY manifests ./manifests
COPY platform/backend ./platform/backend
COPY platform/config ./platform/config
COPY platform/samples ./platform/samples
COPY platform/workers ./platform/workers

RUN python -m pip install --upgrade pip \
    && python -m pip install --no-cache-dir fastapi "uvicorn[standard]" redis rq \
    && python -m pip install --no-cache-dir --no-deps -e .

EXPOSE 8000

CMD ["uvicorn", "main:app", "--app-dir", "platform/backend/app", "--host", "0.0.0.0", "--port", "8000"]
